# ==============================================================
# JobRadar AI - Variables de entorno
# 1. Copiar este archivo:  cp .env.example .env
# 2. Completar los valores
# 3. NUNCA commitear el archivo .env
# ==============================================================

# Clave para encriptar credenciales guardadas en n8n
# Generar una con:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Zona horaria para los trigger diarios
TIMEZONE=America/Argentina/Buenos_Aires

# ---- API keys (se cargan en n8n como credenciales, no acá, salvo que
# uses nodos HTTP Request con headers manuales) ----

# Apify (account > Settings > Integrations > API token)
# APIFY_TOKEN=
# Actor de LinkedIn Jobs elegido, ej: "curious_coder~linkedin-jobs-scraper"
# APIFY_ACTOR_ID=

# Google Gemini (de https://aistudio.google.com/apikey)
# GEMINI_API_KEY=

# Telegram Bot (de @BotFather)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Google Sheets (OAuth via n8n, o Service Account)
# GOOGLE_SHEETS_DOC_ID=
